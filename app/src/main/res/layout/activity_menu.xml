<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_login_layout"
    android:contextClickable="false"
    android:background="#E3DEFF">

    <ImageView
        android:layout_width="256dp"
        android:layout_height="318dp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.22"
        app:srcCompat="@drawable/img" />

    <ImageView
        android:layout_width="181dp"
        android:layout_height="226dp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/img_1" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="411dp"
        android:layout_height="138dp"
        android:layout_marginBottom="184dp"
        android:rotationX="180"
        android:rotationY="180"
        android:scaleType="fitXY"
        android:src="@drawable/wave"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="421dp"
        android:layout_height="234dp"
        android:layout_marginBottom="4dp"
        android:rotationX="180"
        android:rotationY="180"
        android:scaleType="fitXY"
        android:src="@drawable/quadrado_white"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="-10dp" />

    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="190dp"
        android:background="@drawable/circle_white"
        android:clipToOutline="true"
        android:padding="0dp"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="174dp">

        <ImageView
            android:layout_width="206dp"
            android:layout_height="199dp"
            android:scaleType="centerCrop"
            android:src="@drawable/menina_and_dog" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="124dp"
        android:layout_height="120dp"
        android:background="@drawable/circle_white"
        android:clipToOutline="true"
        android:elevation="4dp"
        android:padding="0dp"
        tools:layout_editor_absoluteX="273dp"
        tools:layout_editor_absoluteY="316dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/gato" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="129dp"
        android:layout_height="119dp"
        android:background="@drawable/circle_white"
        android:clipToOutline="true"
        android:elevation="4dp"
        android:padding="0dp"
        tools:layout_editor_absoluteX="266dp"
        tools:layout_editor_absoluteY="55dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/dog" />
    </FrameLayout>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="357dp"
        android:layout_height="94dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="27dp"
        android:autoSizeTextType="uniform"
        android:text="Encontre seu novo Xamêgo!"
        android:textAlignment="center"
        android:textColor="#343A40"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageView6"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/imageView6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="335dp"
        android:layout_height="51dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="38dp"
        android:color="#d3d3d3"
        android:text="Descubra pets prontos para receber amor e faça parte de uma nova história.🐾"
        android:textAlignment="center"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageView5"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/imageView5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.854" />

    <Button
        android:id="@+id/buttonEntrar"
        android:layout_width="346dp"
        android:layout_height="58dp"
        android:layout_marginStart="26dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="33dp"
        android:backgroundTint="#4E35A4"
        android:elevation="3dp"
        android:text="ver pets disponiveis"
        android:textColor="@color/white"
        android:textSize="10dp"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageView5"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/imageView5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.975" />


</androidx.constraintlayout.widget.ConstraintLayout>